<div class="flex justify-center md:justify-between items-center mb-6">
  <h1 class="text-center md:text-left text-[28px] md:text-[40px] font-serif font-bold md:font-black tracking-[-0.01em] text-neutral-black">
    {{ section.settings.title }}
  </h1>
  <a
    href="{{ section.settings.cta_link }}"
    class="hidden md:flex items-end gap-x-2 font-poppins font-semibold text-sm tracking-[-0.03em] text-[#5C553A] capitalize hover:underline"
  >
    {{ section.settings.cta_text }}

    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M3.33334 10H16.6667M16.6667 10L11.6667 5M16.6667 10L11.6667 15"
        stroke="#5C553A"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </a>
</div>
