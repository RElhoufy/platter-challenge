<div class="product-card md:w-[355px] md:max-h-[467px]">
  <div class="product-card__image relative aspect-square overflow-hidden rounded-[10px] group">
    {{
      product.featured_image
      | image_url: width: 355
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'h-full w-full object-cover transition-opacity duration-300 md:group-hover:opacity-0 group-hover:opacity-100',
        alt: product.title
    }}
    {{
      product.images[1]
      | image_url: width: 355
      | image_tag:
        loading: 'lazy',
        fetchpriority: 'low',
        class: 'absolute inset-0 h-full w-full object-cover transition-opacity duration-300 opacity-0 md:group-hover:opacity-100',
        alt: product.title
      | append: ' - Alternative view'
    }}

    {% if product.metafields.product.primary_badge %}
      <div
        class="
          product-card__badge
          absolute top-0 left-0 mt-1 md:mt-2 ml-1 md:ml-2
          flex h-[18px] md:h-5 w-[51px] md:w-[61px] items-center justify-center
          whitespace-nowrap rounded-full border border-black bg-white
          font-bebas text-[8px] md:text-[10px] uppercase tracking-[0.04em] md:tracking-[0.06em]
        "
      >
        {{ product.metafields.product.primary_badge }}
      </div>
    {% endif %}
    {% if product.metafields.product.secondary_badge %}
      <div
        class="
          product-card__badge
          absolute top-0 right-0 mt-1 md:mt-2 mr-1 md:mr-7
          flex h-[18px] md:h-5 w-[51px] md:w-[61px] items-center justify-center
          whitespace-nowrap rounded-full border border-black bg-[#5C7962]
          font-bebas text-[8px] md:text-[10px] uppercase tracking-[0.04em] md:tracking-[0.06em] text-white
        "
      >
        {{ product.metafields.product.secondary_badge }}
      </div>
    {% endif %}
  </div>

  <div
    class="
      product-card__title
      ml-2 md:ml-3 mt-2 md:mt-4 max-w-[80%]
      font-bebas uppercase tracking-[0.03em] text-custom-black leading-[120%] text-base md:text-[18px]
    "
  >
    {{ product.title }}
  </div>

  <div class="product-card__reviews ml-2 md:ml-3 mt-1 md:mt-2 flex items-baseline gap-1">
    <div class="product-card__reviews-rating items-center gap-[2px] hidden md:flex">
      {% render 'star-rating', rating: product.metafields.product.star_rating, width: 10, height: 10 %}
    </div>
    <div class="product-card__reviews-rating flex items-center gap-[1px] md:hidden">
      {% render 'star-rating', rating: product.metafields.product.star_rating, width: 7, height: 7 %}
    </div>
    <span class="product-card__reviews-count font-poppins text-[11px] md:text-xs text-[#707070]">
      {{ product.metafields.product.number_of_reviews }} Reviews
    </span>
  </div>

  <div class="product-card__price ml-2 mt-2 font-poppins font-medium text-custom-black text-base">
    {{ product.price | money }}
  </div>
</div>
